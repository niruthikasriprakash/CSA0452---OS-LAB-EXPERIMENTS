#include <stdio.h>

int main() {
    int index, n, blocks[20], i;

    printf("Enter index block: ");
    scanf("%d", &index);

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers: ");
    for(i = 0; i < n; i++)
        scanf("%d", &blocks[i]);

    printf("Index Block %d contains:\n", index);
    for(i = 0; i < n; i++)
        printf("%d ", blocks[i]);

    return 0;
}
