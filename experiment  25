#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd;
    char data[100];
    struct stat s;
    DIR *d;
    struct dirent *dir;

    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    write(fd, "Hello World", 11);

    lseek(fd, 0, SEEK_SET);

    read(fd, data, 11);
    data[11] = '\0';

    printf("File Content: %s\n", data);

    stat("sample.txt", &s);
    printf("File Size: %ld bytes\n", s.st_size);

    d = opendir(".");
    printf("Directory files:\n");
    while ((dir = readdir(d)) != NULL) {
        printf("%s\n", dir->d_name);
    }
    closedir(d);

    close(fd);
    return 0;
}
