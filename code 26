#include <stdio.h>

int main() {
    FILE *fp;
    char ch;

    fp = fopen("file.txt", "w");
    fprintf(fp, "Operating System Lab");
    fclose(fp);

    fp = fopen("file.txt", "a");
    fprintf(fp, "\nFile Management");
    fclose(fp);

    fp = fopen("file.txt", "r");
    printf("File Content:\n");
    while ((ch = fgetc(fp)) != EOF) {
        printf("%c", ch);
    }
    fclose(fp);

    return 0;
}
