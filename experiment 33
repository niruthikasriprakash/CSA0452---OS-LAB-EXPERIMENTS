#include <stdio.h>

int main() {
    int pages[20], frame[10];
    int n, f, i, j, k, pos, farthest, fault = 0, found;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter pages: ");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter frames: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++)
        frame[i] = -1;

    for(i = 0; i < n; i++) {
        found = 0;

        for(j = 0; j < f; j++) {
            if(frame[j] == pages[i]) {
                found = 1;
                break;
            }
        }

        if(!found) {
            pos = -1;
            farthest = i;

            for(j = 0; j < f; j++) {
                for(k = i + 1; k < n; k++) {
                    if(frame[j] == pages[k])
                        break;
                }

                if(k == n) {
                    pos = j;
                    break;
                }

                if(k > farthest) {
                    farthest = k;
                    pos = j;
                }
            }

            if(pos == -1)
                pos = 0;

            frame[pos] = pages[i];
            fault++;
        }
    }

    printf("Page Faults = %d", fault);
    return 0;
}
